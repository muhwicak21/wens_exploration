<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- WENS Exploration with MAVROS -->
  <!-- Launches a simulated drone using PX4 SITL + Gazebo + MAVROS -->

  <arg name="vehicle"       default="iris"/>
  <arg name="world"         default="$(find wens_exploration_mavros)/worlds/exploration_world.world"/>
  <arg name="fcu_url"       default="udp://:14540@127.0.0.1:14557"/>
  <arg name="gcs_url"       default=""/>
  <arg name="tgt_system"    default="1"/>
  <arg name="tgt_component" default="1"/>
  <arg name="log_output"    default="screen"/>
  <arg name="fcu_protocol"  default="v2.0"/>
  <arg name="respawn_mavros" default="false"/>

  <!-- Launch Gazebo with the exploration world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="true"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- Spawn the vehicle model -->
  <node name="$(arg vehicle)_spawn"
        pkg="gazebo_ros"
        type="spawn_model"
        respawn="false"
        output="$(arg log_output)"
        args="-urdf -param robot_description -model $(arg vehicle) -x 0 -y 0 -z 0.1"/>

  <!-- Launch MAVROS -->
  <include file="$(find mavros)/launch/node.launch">
    <arg name="pluginlists_yaml" value="$(find mavros)/launch/px4_pluginlists.yaml"/>
    <arg name="config_yaml"      value="$(find mavros)/launch/px4_config.yaml"/>
    <arg name="fcu_url"          value="$(arg fcu_url)"/>
    <arg name="gcs_url"          value="$(arg gcs_url)"/>
    <arg name="tgt_system"       value="$(arg tgt_system)"/>
    <arg name="tgt_component"    value="$(arg tgt_component)"/>
    <arg name="log_output"       value="$(arg log_output)"/>
    <arg name="fcu_protocol"     value="$(arg fcu_protocol)"/>
    <arg name="respawn_mavros"   value="$(arg respawn_mavros)"/>
  </include>

  <!-- Launch the WENS exploration node -->
  <node name="wens_exploration_node"
        pkg="wens_exploration_mavros"
        type="exploration_node.py"
        output="screen">
    <rosparam file="$(find wens_exploration_mavros)/config/exploration_params.yaml" command="load"/>
  </node>

</launch>
