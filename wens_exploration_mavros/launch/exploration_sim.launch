<?xml version="1.0"?>
<!--
  Main launch file for WENS exploration with MAVROS (simulation).
  Launches Gazebo with PX4 SITL, MAVROS, OctoMap server, and the exploration stack.
-->
<launch>
  <!-- Arguments -->
  <arg name="vehicle"         default="iris"/>
  <arg name="world"           default="$(find wens_exploration_mavros)/worlds/exploration_world.world"/>
  <arg name="fcu_url"         default="udp://:14540@localhost:14557"/>
  <arg name="gcs_url"         default=""/>
  <arg name="tgt_system"      default="1"/>
  <arg name="tgt_component"   default="1"/>
  <arg name="takeoff_altitude" default="2.5"/>
  <arg name="mission_type"    default="frontier"/>
  <arg name="rviz"            default="true"/>

  <!-- Gazebo simulation -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="true"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- MAVROS -->
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url"       value="$(arg fcu_url)"/>
    <arg name="gcs_url"       value="$(arg gcs_url)"/>
    <arg name="tgt_system"    value="$(arg tgt_system)"/>
    <arg name="tgt_component" value="$(arg tgt_component)"/>
  </include>

  <!-- OctoMap server for 3D mapping -->
  <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
    <param name="resolution"             value="0.2"/>
    <param name="frame_id"               value="map"/>
    <param name="sensor_model/max_range" value="8.0"/>
    <param name="latch"                  value="false"/>
    <remap from="cloud_in" to="/camera/depth/points"/>
  </node>

  <!-- Frontier detector -->
  <node pkg="wens_exploration_mavros" type="frontier_detector" name="frontier_detector" output="screen">
    <param name="exploration_altitude" value="$(arg takeoff_altitude)"/>
    <param name="min_frontier_size"    value="3"/>
    <param name="publish_rate"         value="1.0"/>
    <param name="map_frame"            value="map"/>
  </node>

  <!-- Exploration controller (Python) -->
  <node pkg="wens_exploration_mavros" type="exploration_controller.py"
        name="exploration_controller" output="screen">
    <param name="takeoff_altitude"   value="$(arg takeoff_altitude)"/>
    <param name="waypoint_tolerance" value="0.5"/>
    <param name="hover_duration"     value="2.0"/>
  </node>

  <!-- Mission planner -->
  <node pkg="wens_exploration_mavros" type="mission_planner.py"
        name="mission_planner" output="screen">
    <param name="mission_type"   value="$(arg mission_type)"/>
    <param name="flight_altitude" value="$(arg takeoff_altitude)"/>
    <param name="auto_start"     value="true"/>
  </node>

  <!-- RViz visualization -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find wens_exploration_mavros)/config/exploration.rviz"/>

  <!-- Static transform: map -> odom (placeholder) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 1 map odom"/>

</launch>
