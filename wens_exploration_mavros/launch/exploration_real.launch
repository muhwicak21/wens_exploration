<?xml version="1.0"?>
<!--
  Launch file for WENS exploration on a real UAV with MAVROS.
  Use this when flying with a physical PX4/ArduPilot flight controller.
-->
<launch>
  <!-- Arguments -->
  <arg name="fcu_url"          default="/dev/ttyUSB0:921600"/>
  <arg name="gcs_url"          default="udp://@192.168.1.100:14550"/>
  <arg name="tgt_system"       default="1"/>
  <arg name="tgt_component"    default="1"/>
  <arg name="takeoff_altitude" default="2.5"/>
  <arg name="mission_type"     default="frontier"/>
  <arg name="rviz"             default="false"/>

  <!-- MAVROS -->
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url"       value="$(arg fcu_url)"/>
    <arg name="gcs_url"       value="$(arg gcs_url)"/>
    <arg name="tgt_system"    value="$(arg tgt_system)"/>
    <arg name="tgt_component" value="$(arg tgt_component)"/>
  </include>

  <!-- OctoMap server -->
  <node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
    <param name="resolution"             value="0.2"/>
    <param name="frame_id"               value="map"/>
    <param name="sensor_model/max_range" value="6.0"/>
    <param name="latch"                  value="false"/>
    <remap from="cloud_in" to="/camera/depth/points"/>
  </node>

  <!-- Frontier detector -->
  <node pkg="wens_exploration_mavros" type="frontier_detector" name="frontier_detector" output="screen">
    <param name="exploration_altitude" value="$(arg takeoff_altitude)"/>
    <param name="min_frontier_size"    value="3"/>
    <param name="publish_rate"         value="0.5"/>
    <param name="map_frame"            value="map"/>
  </node>

  <!-- Exploration controller -->
  <node pkg="wens_exploration_mavros" type="exploration_controller.py"
        name="exploration_controller" output="screen">
    <param name="takeoff_altitude"   value="$(arg takeoff_altitude)"/>
    <param name="waypoint_tolerance" value="0.5"/>
    <param name="hover_duration"     value="3.0"/>
  </node>

  <!-- Mission planner -->
  <node pkg="wens_exploration_mavros" type="mission_planner.py"
        name="mission_planner" output="screen">
    <param name="mission_type"    value="$(arg mission_type)"/>
    <param name="flight_altitude" value="$(arg takeoff_altitude)"/>
    <param name="auto_start"      value="false"/>
  </node>

  <!-- Optional RViz on companion computer -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find wens_exploration_mavros)/config/exploration.rviz"/>

</launch>
