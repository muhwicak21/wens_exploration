<?xml version="1.0"?>
<package format="2">
  <name>wens_exploration_mavros</name>
  <version>0.1.0</version>
  <description>
    Autonomous aerial exploration package using MAVROS for UAV navigation and control.
    Supports 3D frontier-based exploration with integration for PX4/ArduPilot via MAVROS.
  </description>

  <maintainer email="wens@example.com">WENS Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- ROS Core -->
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- MAVROS -->
  <depend>mavros</depend>
  <depend>mavros_msgs</depend>

  <!-- Octomap for 3D mapping -->
  <depend>octomap_ros</depend>
  <depend>octomap_msgs</depend>

  <!-- Visualization -->
  <depend>visualization_msgs</depend>

  <!-- Action/Service -->
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>

  <!-- Python dependencies -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
  </export>
</package>
